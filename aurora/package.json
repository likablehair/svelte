{
	"name": "@likable-hair/svelte",
	"version": "5.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && node scripts/build-spec.ts && publint",
		"prepack": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p migrate && tsc -p mcp --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:related": "vitest related --run",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots",
		"migrate:rules": "node migrate/scripts/compile-rules.ts",
		"migrate:compat": "node migrate/scripts/v4-compat.ts",
		"migrate": "node migrate/src/cli.ts",
		"migrate:build": "node migrate/scripts/build.ts",
		"mcp": "node mcp/src/cli.ts",
		"mcp:build": "node mcp/scripts/build.ts"
	},
	"files": [
		"dist",
		"skills",
		"MIGRATION.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./tokens.css": "./dist/css/tokens.css",
		"./base.css": "./dist/css/base.css",
		"./v4-compat.css": "./dist/css/v4-compat.css",
		"./themes/*.css": "./dist/themes/*.css",
		"./tailwind.css": "./dist/tailwind.css",
		"./tailwind-preset": {
			"types": "./dist/tailwind-preset.d.ts",
			"default": "./dist/tailwind-preset.js"
		},
		"./spec.json": "./dist/spec.json",
		"./skills/*": "./skills/*"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@mdi/js": "^7.4.47",
		"@modelcontextprotocol/sdk": "^1.30.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.0",
		"@vitest/browser-playwright": "~4.1.11",
		"playwright": "^1.64.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "~4.1.11",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@tanstack/virtual-core": "^3.17.11",
		"chart.js": "^4.5.1",
		"chartjs-plugin-zoom": "^2.2.0",
		"flag-icons": "^7.5.0"
	}
}
