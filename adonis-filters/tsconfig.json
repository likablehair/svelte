{
	"compilerOptions": {
		"target": "es2020",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src", "tests", "scripts"]
}
